# Copy to .env.local for local runs, or set these on the Vercel project.
# Every variable is optional: with none set, the demo uses bundled data and
# calls the Lambda with your local AWS profile.

# ── Model (AI Gateway) ───────────────────────────────────────────────
# Any AI Gateway model ID that Bedrock serves. Default: anthropic/claude-haiku-5.5
# SURF_MODEL=anthropic/claude-sonnet-5.5
# Providers AI Gateway may use, comma-separated. Default: bedrock
# SURF_PROVIDERS=bedrock

# ── Live surf report (AWS Lambda) ────────────────────────────────────
# IAM role the deployed agent assumes via Vercel OIDC (no AWS keys stored).
# Leave unset locally to use AWS_PROFILE instead.
# AWS_ROLE_ARN=arn:aws:iam::<account>:role/surf-agent-eve-vercel-role
# SURF_AWS_REGION=us-east-1
# SURF_LAMBDA_NAME=surf_report

# ── Spot data (Glassy Supabase, public read) ─────────────────────────
# Unset = bundled snapshot in data/destinations.json.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=<anon key>

# ── Web chat access ─────────────────────────────────────────────────
# true = anonymous visitors of the site may chat (rate-limited, same-origin).
# Unset = production browser requests get 401.
# PUBLIC_DEMO=true
